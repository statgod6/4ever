# Anything not explicitly needed at build time stays out of the image.
# Keeps the context small (faster builds) and prevents accidental secret leaks.

# Dependencies - rebuilt in the image
node_modules
dist
.prisma

# Env + secrets (ALWAYS excluded; never bake secrets into images)
.env
.env.*
!.env.example

# Logs & caches
*.log
boot-*.log
npm-debug.log*
yarn-debug.log*
coverage
.nyc_output

# Local scratch / test scripts (dev-only)
test-*.js
list-users.js
flip-tier.js
check-db.sql
scripts

# Editor / VCS / OS cruft
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Docker itself
Dockerfile
.dockerignore
docker-compose*.yml

# Local runtime uploads (container creates a fresh empty volume)
uploads

# Docs
README.md
*.md

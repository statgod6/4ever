# Database Configuration
POSTGRES_USER=thinkingos
POSTGRES_PASSWORD=thinkingos_secret
POSTGRES_DB=thinkingos
DATABASE_URL=postgresql://thinkingos:thinkingos_secret@localhost:5432/thinkingos?schema=public

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# OpenRouter Configuration (for AI personas)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o

# Server Configuration
PORT=3001
NODE_ENV=development

# Ontology Intelligence Layer (Self / Relational / Emotional snapshots)
# When true, Core Chat + Personas receive a typed ontology snapshot as Layer 0
# context in addition to raw retrieval. Safe to enable after running the
# backfill script: npx ts-node backend/scripts/ontology-backfill.ts
ONTOLOGY_ENABLED=true

# Knowledge Worker (premium) agent
KW_DEFAULT_MODEL=deepseek/deepseek-v3.2
KW_STREAM_TIMEOUT_MS=180000
# E2B sandbox — used by the Python data-analysis tool. Get a key at https://e2b.dev
E2B_API_KEY=

# Admin dev-only tier flip endpoint (POST /admin/users/:id/tier, header x-admin-secret)
# Leave blank in production (feature disabled when blank).
ADMIN_SECRET=

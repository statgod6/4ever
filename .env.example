# =============================================================================
# 4Ever / ThinkingOS — example environment file
# Copy to `.env` (root) and/or `backend/.env` and fill in with real values.
# NEVER commit a populated .env. This file contains placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Postgres + pgvector)
# -----------------------------------------------------------------------------
POSTGRES_USER=thinkingos
POSTGRES_PASSWORD=replace-me-strong-random-password
POSTGRES_DB=thinkingos
DATABASE_URL=postgresql://thinkingos:replace-me-strong-random-password@localhost:5432/thinkingos?schema=public

# -----------------------------------------------------------------------------
# JWT / Auth
#   - JWT_SECRET MUST be at least 64 random chars. Generate with:
#       node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   - Short access token + long refresh token is the target (see P2 roadmap).
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-64-char-random-hex
JWT_EXPIRATION=7d

# -----------------------------------------------------------------------------
# Sign in with Apple (required for iOS submission — App Store guideline 4.8)
# APPLE_CLIENT_ID = the iOS bundle identifier (e.g. app.fourever.ios). The
# backend verifies every identity token's `aud` claim matches this value.
# Leave blank to disable the /auth/apple endpoint entirely.
# -----------------------------------------------------------------------------
APPLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# OpenRouter (required — powers Core Chat, Personas, Knowledge Worker, TTS)
# Get a key at https://openrouter.ai. Set a monthly spend cap in their dashboard.
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v3.2
# Dated TTS model slug (OpenRouter TTS requires a dated version).
TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Comma-separated list of allowed CORS origins for the backend.
# Production must list only real, owned origins (e.g. https://app.4ever.app).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Twilio SMS (for phone OTP)
# Provision a verified sending number and set a monthly spend cap in Twilio.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=replace-with-twilio-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-token
TWILIO_PHONE_NUMBER=+0000000000

# -----------------------------------------------------------------------------
# Tavily Search (optional — powers web-search tool in Core Chat)
# https://tavily.com — free tier: 1000 searches/month.
# -----------------------------------------------------------------------------
TAVILY_API_KEY=replace-with-tavily-key

# -----------------------------------------------------------------------------
# Ontology Intelligence Substrate v1 (feature flag)
# When true, Core Chat + Personas receive a typed ontology snapshot as Layer 0
# context. Safe to enable after running the backfill script:
#   npx ts-node backend/scripts/ontology-backfill.ts
# -----------------------------------------------------------------------------
ONTOLOGY_ENABLED=true

# -----------------------------------------------------------------------------
# Knowledge Worker (premium) agent
# -----------------------------------------------------------------------------
KW_DEFAULT_MODEL=deepseek/deepseek-v3.2
KW_STREAM_TIMEOUT_MS=180000
# E2B sandbox — used by the Python data-analysis tool. https://e2b.dev
E2B_API_KEY=replace-with-e2b-key

# -----------------------------------------------------------------------------
# Admin tier-flip endpoint (POST /admin/users/:id/tier, header x-admin-secret)
# Leave blank to fully disable the endpoint. In production prefer a real
# billing webhook (Stripe) instead of a shared secret.
# -----------------------------------------------------------------------------
ADMIN_SECRET=

# -----------------------------------------------------------------------------
# Mobile (Expo) — consumed at build time, not runtime.
# Set in `mobile/.env` for local dev or via `EXPO_PUBLIC_API_URL` in EAS secrets.
#   - Dev   : http://<LAN-IP>:3001   (physical device via Expo Go)
#   - Prod  : https://api.4ever.app  (your owned HTTPS domain)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3001
